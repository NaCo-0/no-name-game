{
  "name": "isometric-terrain",
  "version": "1.0.0",
  "description": "Procedural isometric terrain rendering system for a RoK/Whiteout Survival-style strategy game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "game": "vite --open /game.html",
    "build": "vite build",
    "preview": "vite preview",
    "game:dist": "vite build && vite preview --open /game.html",
    "server": "node backend/src/server.js",
    "server:install": "npm --prefix backend install",
    "server:test": "npm --prefix backend test",
    "server:dev": "node --watch backend/src/server.js",
    "seed": "npm --prefix backend run seed",
    "seed:demo": "npm --prefix backend run seed:demo",
    "admin:install": "npm --prefix admin-panel install",
    "admin:dev": "npm --prefix admin-panel run dev",
    "admin:build": "npm --prefix admin-panel run build"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "vite": "^5.4.0"
  }
}